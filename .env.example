# Nino's Collectibles — server-only settings. Never commit a filled-in copy.

# Owner sign-in needs no pre-set password: on the first visit to /admin/login
# Nino creates the owner account himself (email + password), or signs in with
# Square and that account becomes the owner. Optional extras:
#  - A one-time setup code to hand to Nino so nobody else can claim the first
#    visit (recommended on a public URL):
NUXT_ADMIN_SETUP_CODE=
#  - Sign in with Square: register an application at developer.squareup.com,
#    add <site>/api/admin/auth/square/callback as a redirect URL, then set
NUXT_SQUARE_APP_ID=
NUXT_SQUARE_APP_SECRET=
#  - A fixed password hash instead (node scripts/admin-password.mjs):
NUXT_ADMIN_PASSWORD_HASH=

# Seals the HTTP-only session cookie. Optional: when empty, one is generated on
# first start and kept in the admin store. Set it explicitly (32+ random chars)
# on hosting with an ephemeral filesystem so sessions survive cold starts:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_SECRET=

# Demo mode: fixed password "demo-nino" and clearly labelled SAMPLE data.
# Preview only. Leave unset (or 0) anywhere real inventory lives.
NUXT_ADMIN_DEMO=0

# Where admin records and uploads are stored (filesystem driver, preview only).
NUXT_ADMIN_DATA_DIR=.data/admin

# Square API environment for both sign-in and catalog sync: sandbox | production
NUXT_SQUARE_ENV=production
# Override the OAuth redirect URL only if the site is served behind a different host.
NUXT_SQUARE_REDIRECT_URL=
# Fallback without OAuth: a personal access token (self-hosted setups only).
NUXT_SQUARE_ACCESS_TOKEN=
NUXT_SQUARE_LOCATION_ID=
