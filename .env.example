# Nino's Collectibles admin — server-only settings.
# Set these in Vercel (Project → Settings → Environment Variables). Never commit real values.

# --- Required before the admin can be used -----------------------------------
# Durable storage. Connect a Redis database to the Vercel project
# (Storage → Redis or Upstash); Vercel then sets REDIS_URL automatically.
# Without it, the admin stays locked on Vercel instead of losing data.
REDIS_URL=

# Seals session cookies and the stored Square tokens. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_SECRET=

# One-time code Nino types to create the owner account. 12+ characters:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# Give it to Nino privately. It stops working once his account exists.
NUXT_ADMIN_SETUP_CODE=

# --- Square (optional; needed for Connect Square) -----------------------------
# From a Square application at developer.squareup.com. Register this redirect URL
# on the app's OAuth page: https://<site>/api/admin/auth/square/callback
NUXT_SQUARE_APP_ID=
NUXT_SQUARE_APP_SECRET=
# sandbox for testing with a Square sandbox account, production for Nino's real account.
NUXT_SQUARE_ENV=sandbox
# Only if the site is reached through a host other than the one Square redirects to.
NUXT_SQUARE_REDIRECT_URL=

# --- Local preview only ---------------------------------------------------------
# 1 = demo mode: in-memory SAMPLE data, fixed password demo-nino, never touches
# Redis or Square. Ignored on the production deployment.
NUXT_ADMIN_DEMO=0
# Local disk location when REDIS_URL is not set (development only).
NUXT_ADMIN_DATA_DIR=.data/admin
# NUXT_SQUARE_API_ORIGIN / NUXT_SQUARE_AUTHORIZE_URL point the OAuth flow at a
# local mock for automated tests. Leave unset everywhere else.
